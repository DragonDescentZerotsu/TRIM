# Project data and cached assets
data/cache/
data/features/
data/processed/
data/raw/

# Generated experiment artifacts
outputs/logs/
outputs/models/
outputs/plots/
outputs/predictions/
outputs/metrics/*/

# Keep top-level metric summaries, ignore nested intermediates
outputs/metrics/**/*.pkl
outputs/metrics/**/*.parquet
outputs/metrics/**/*.npy
outputs/metrics/**/*.npz
outputs/metrics/**/*.csv
outputs/metrics/**/*.json
!outputs/metrics/*.csv
!outputs/metrics/*.json
